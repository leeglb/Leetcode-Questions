class Solution(object):
    def moveZeroes(self, nums):
        """
        :type nums: List[int]
        :rtype: None Do not return anything, modify nums in-place instead.
        """
        
        left = 0 
        right = left + 1 
        
        while left < right: 
            
            current_left = 0
            
            if nums[left] != 0:
                
                current_left = nums[left]
                
                