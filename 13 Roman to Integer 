class Solution(object):
    def romanToInt(self, s):
        """
        :type s: str
        :rtype: int
        """
        roman_dict = {'I': 1, 
                      'V': 5,
                      'X': 10,
                      'L': 50,
                      'C': 100,
                      'D': 500,
                      'M': 1000}


        value = 0 

        for i in range(0, len(s)):
            current = roman_dict[s[i]]
            next_value = roman_dict[s[i + 1]] if (i + 1) < len(s) else 0
            
            if current < next_value:
                value -= current
                
            else:
                value += current 
                
                
                
        return value

      